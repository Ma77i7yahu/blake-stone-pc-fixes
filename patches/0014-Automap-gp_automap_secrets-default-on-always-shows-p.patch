From e3607db13548773ba6532d85d720c4eafe4418ad Mon Sep 17 00:00:00 2001
From: Ma77i7yahu <353917094+Ma77i7yahu@users.noreply.github.com>
Date: Sat, 14 Nov 2026 12:47:30 +1100
Subject: [PATCH 14/16] Automap: gp_automap_secrets (default on) always shows
 pushwalls and hidden areas

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/bstone/src/3d_def.h    |  1 +
 src/bstone/src/3d_draw.cpp | 32 +++++++++++++++++++++++++++++---
 src/bstone/src/3d_main.cpp | 17 +++++++++++++++++
 3 files changed, 47 insertions(+), 3 deletions(-)

diff --git a/src/bstone/src/3d_def.h b/src/bstone/src/3d_def.h
index ab2b0800..1ce4d119 100644
--- a/src/bstone/src/3d_def.h
+++ b/src/bstone/src/3d_def.h
@@ -4006,6 +4006,7 @@ bool gp_momentum() noexcept;
 void gp_momentum(bool is_enabled);
 int gp_momentum_accel_ms() noexcept;
 int gp_momentum_friction_ms() noexcept;
+bool gp_automap_secrets() noexcept;
 bool gp_slow_strafe() noexcept;
 void gp_slow_strafe(bool is_enabled);
 int gp_strafe_speed_pct() noexcept;
diff --git a/src/bstone/src/3d_draw.cpp b/src/bstone/src/3d_draw.cpp
index f9fc021d..983749db 100644
--- a/src/bstone/src/3d_draw.cpp
+++ b/src/bstone/src/3d_draw.cpp
@@ -2213,6 +2213,8 @@ void ShowOverhead(
 	const auto diameter = static_cast<int>(radius * 2.0);
 
 	const auto is_show_all = ((flags & OV_SHOWALL) != 0);
+	const auto is_show_secrets = gp_automap_secrets();
+	const auto pwall_color = (assets_info.is_aog() ? PWALL_COLOR : std::uint8_t{0x79});
 
 	// Draw rotated radar.
 	//
@@ -2344,7 +2346,8 @@ void ShowOverhead(
 						}
 					}
 
-					if ((ExtraRadarFlags & OV_PUSHWALLS) != 0 ||
+					if (is_show_secrets ||
+						(ExtraRadarFlags & OV_PUSHWALLS) != 0 ||
 						(assets_info.is_ps() && zoom == 4 && (flags & OV_PUSHWALLS) != 0))
 					{
 						auto iconnum = mapsegs[1][farmapylookup[my] + mx];
@@ -2353,9 +2356,9 @@ void ShowOverhead(
 						//
 						if (iconnum == PUSHABLETILE)
 						{
-							if (show_pwalls_on_automap(mx, my, is_show_all))
+							if (show_pwalls_on_automap(mx, my, is_show_all || is_show_secrets))
 							{
-								color = (assets_info.is_aog() ? PWALL_COLOR : 0x79);
+								color = pwall_color;
 							}
 						}
 					}
@@ -2363,6 +2366,29 @@ void ShowOverhead(
 				else
 				{
 					color = UNMAPPED_COLOR;
+
+					// SHOW SECRETS (gp_automap_secrets): pushwalls and hidden-area
+					// floors are revealed even before they have been visited.
+					//
+					if (is_show_secrets)
+					{
+						const auto tile = tilemap[mx][my];
+
+						if (tile != 0 &&
+							mapsegs[1][farmapylookup[my] + mx] == PUSHABLETILE)
+						{
+							color = pwall_color;
+						}
+						else if (tile == 0 || (tile & 0xC0) != 0)
+						{
+							static_cast<void>(GetAreaNumber(mx, my));
+
+							if (GAN_HiddenArea)
+							{
+								color = HIDDEN_COLOR;
+							}
+						}
+					}
 				}
 			}
 
diff --git a/src/bstone/src/3d_main.cpp b/src/bstone/src/3d_main.cpp
index e11ba3e6..164c1d53 100644
--- a/src/bstone/src/3d_main.cpp
+++ b/src/bstone/src/3d_main.cpp
@@ -11142,6 +11142,17 @@ auto gp_momentum_friction_ms_cvar = bstone::CVar{
 	0,
 	2000};
 
+// gp_automap_secrets (automap always shows pushwalls and hidden areas)
+
+constexpr auto gp_automap_secrets_cvar_name = bstone::StringView{"gp_automap_secrets"};
+constexpr auto gp_automap_secrets_default = true;
+
+auto gp_automap_secrets_cvar = bstone::CVar{
+	bstone::CVarBoolTag{},
+	gp_automap_secrets_cvar_name,
+	bstone::CVarFlags::archive,
+	gp_automap_secrets_default};
+
 // gp_slow_strafe (sideways movement uses gp_strafe_speed_pct of normal speed)
 
 constexpr auto gp_slow_strafe_cvar_name = bstone::StringView{"gp_slow_strafe"};
@@ -11240,6 +11251,7 @@ void gp_initialize_cvars(bstone::CVarMgr& cvar_mgr)
 	cvar_mgr.add(gp_momentum_cvar);
 	cvar_mgr.add(gp_momentum_accel_ms_cvar);
 	cvar_mgr.add(gp_momentum_friction_ms_cvar);
+	cvar_mgr.add(gp_automap_secrets_cvar);
 	cvar_mgr.add(gp_slow_strafe_cvar);
 	cvar_mgr.add(gp_strafe_speed_pct_cvar);
 	cvar_mgr.add(gp_momentum_style_cvar);
@@ -11452,6 +11464,11 @@ int gp_momentum_friction_ms() noexcept
 	return gp_momentum_friction_ms_cvar.get_int32();
 }
 
+bool gp_automap_secrets() noexcept
+{
+	return gp_automap_secrets_cvar.get_bool();
+}
+
 bool gp_slow_strafe() noexcept
 {
 	return gp_slow_strafe_cvar.get_bool();
