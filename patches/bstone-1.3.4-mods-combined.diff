+// Momentum: the player speeds up and slows down over a short time instead of instantly.
+// Velocity is in tiles per tic. Off during demos so recorded input plays back the same.
+
+extern bool demorecord;
+extern bool demoplayback;
+
+namespace {
+
+bool momentum_is_collecting_ = false;
+double momentum_wish_x_ = 0.0;
+double momentum_wish_y_ = 0.0;
+double momentum_velocity_x_ = 0.0;
+double momentum_velocity_y_ = 0.0;
+
+// Sideways speed multiplier (gp_slow_strafe / gp_strafe_speed_pct); full speed in demos.
+double strafe_speed_scale() noexcept
+{
+	if (!gp_slow_strafe() || demorecord || demoplayback)
+	{
+		return 1.0;
+	}
+
+	return gp_strafe_speed_pct() / 100.0;
+}
+
+bool momentum_is_enabled() noexcept
+{
+	return gp_momentum() && !demorecord && !demoplayback;
+}
+
+// Movement requested by ControlMovement; collected while momentum is on.
+void player_thrust(
+	std::int16_t angle,
+	double speed)
+{
+	if (!momentum_is_collecting_)
+	{
+		Thrust(angle, speed);
+		return;
+	}
+
+	momentum_wish_x_ += speed * costable[angle];
+	momentum_wish_y_ -= speed * sintable[angle];
+}
+
+void momentum_begin() noexcept
+{
+	momentum_is_collecting_ = momentum_is_enabled();
+	momentum_wish_x_ = 0.0;
+	momentum_wish_y_ = 0.0;
+
+	if (!momentum_is_collecting_)
+	{
+		momentum_velocity_x_ = 0.0;
+		momentum_velocity_y_ = 0.0;
+	}
+}
+
+// Duke Nukem 3D movement (player.c getinput/processinput), converted to Blake Stone units.
+//
+// Duke, per 30 Hz game tic: vel += input * accel; vel *= dukefriction (0xCC00 / 65536 = 0.797);
+// vel is zeroed once tiny. Forward and sideways input are clamped separately (MAXVEL 90, MAXSVEL 90,
+// running = 80), so strafing runs at full speed and diagonals are ~1.41x faster.
+// Steady running speed = 4708 build units/s. Scale: 1 tile = 1024 build units (Duke's typical
+// ceiling height vs Blake's tile-high walls; both eyes sit at about half the room height),
+// so Duke running = 4.6 tiles/s, walking 2.3 tiles/s.
+double duke_wish_x_ = 0.0;
+double duke_wish_y_ = 0.0;
+
+constexpr auto duke_friction_30hz = 52224.0 / 65536.0;
+constexpr auto duke_run_tiles_per_second = 4708.0 / 1024.0;
+constexpr auto duke_max_input = 90.0 / 80.0;
+
+// Forward/strafe input in units of full running input (1 = running, 0.5 = walking).
+void duke_set_wish(
+	const objtype* ob,
+	double forward,
+	double right) noexcept
+{
+	forward = std::max(-duke_max_input, std::min(forward, duke_max_input));
+	right = std::max(-duke_max_input, std::min(right, duke_max_input));
+
+	// Separate forward/back and sideways top speeds (Duke itself uses the same for both).
+	forward *= gp_duke_speed_pct() / 100.0;
+	right *= gp_duke_strafe_pct() / 100.0;
+
+	const auto c = costable[ob->angle];
+	const auto s = sintable[ob->angle];
+
+	// Forward = (cos, -sin), right = (sin, cos) in Blake Stone's map axes.
+	duke_wish_x_ = (forward * c) + (right * s);
+	duke_wish_y_ = (-forward * s) + (right * c);
+}
+
+void duke_step(
+	int tic_count,
+	double& move_x,
+	double& move_y) noexcept
+{
+	// Same response at 70 Hz: friction^(30/70) per tic, thrust chosen for the same top speed.
+	static const auto friction = std::pow(duke_friction_30hz, 30.0 / TickBase);
+	const auto run_speed = duke_run_tiles_per_second / TickBase;
+	const auto thrust = run_speed * (1.0 - friction) / friction;
+
+	// Duke zeroes velocity below 2048 of ~2.57M (running) per axis.
+	const auto stop_speed = run_speed * (2048.0 / 2571008.0);
+	const auto has_wish = (duke_wish_x_ != 0.0 || duke_wish_y_ != 0.0);
+
+	const auto is_instant = !gp_duke_slide();
+
+	for (auto i = 0; i < tic_count; ++i)
+	{
+		if (is_instant)
+		{
+			// No acceleration or slide: straight to Duke's top speed, stop dead on release.
+			momentum_velocity_x_ = duke_wish_x_ * run_speed;
+			momentum_velocity_y_ = duke_wish_y_ * run_speed;
+		}
+		else
+		{
+			momentum_velocity_x_ = (momentum_velocity_x_ + (duke_wish_x_ * thrust)) * friction;
+			momentum_velocity_y_ = (momentum_velocity_y_ + (duke_wish_y_ * thrust)) * friction;
+		}
+
+		if (!has_wish && std::abs(momentum_velocity_x_) < stop_speed && std::abs(momentum_velocity_y_) < stop_speed)
+		{
+			momentum_velocity_x_ = 0.0;
+			momentum_velocity_y_ = 0.0;
+		}
+
+		move_x += momentum_velocity_x_;
+		move_y += momentum_velocity_y_;
+	}
+
+	duke_wish_x_ = 0.0;
+	duke_wish_y_ = 0.0;
+}
+
+void momentum_end()
+{
+	if (!momentum_is_collecting_)
+	{
+		return;
+	}
+
+	momentum_is_collecting_ = false;
+
+	const auto tic_count = std::max(static_cast<int>(tics), 1);
+
+	// Requested speed per tic (the requested movement already scales with tics).
+	const auto wish_x = momentum_wish_x_ / tic_count;
+	const auto wish_y = momentum_wish_y_ / tic_count;
+	const auto has_wish = (wish_x != 0.0 || wish_y != 0.0);
+
+	// Rates are relative to full running speed, so the times are 0 -> full run and full run -> 0.
+	constexpr auto run_speed = 70 * MOVESCALE;
+	const auto ramp_ms = has_wish ? gp_momentum_accel_ms() : gp_momentum_friction_ms();
+	const auto max_step = (ramp_ms > 0) ? run_speed / (ramp_ms * TickBase / 1000.0) : 1.0e9;
+
+	auto move_x = 0.0;
+	auto move_y = 0.0;
+
+	if (gp_momentum_style() == momentum_style_duke)
+	{
+		duke_step(tic_count, move_x, move_y);
+	}
+	else
+	for (auto i = 0; i < tic_count; ++i)
+	{
+		const auto delta_x = wish_x - momentum_velocity_x_;
+		const auto delta_y = wish_y - momentum_velocity_y_;
+		const auto delta = std::sqrt((delta_x * delta_x) + (delta_y * delta_y));
+
+		if (delta <= max_step)
+		{
+			momentum_velocity_x_ = wish_x;
+			momentum_velocity_y_ = wish_y;
+		}
+		else
+		{
+			momentum_velocity_x_ += delta_x * (max_step / delta);
+			momentum_velocity_y_ += delta_y * (max_step / delta);
+		}
+
+		move_x += momentum_velocity_x_;
+		move_y += momentum_velocity_y_;
+	}
+
+	auto speed = std::sqrt((move_x * move_x) + (move_y * move_y));
+
+	if (speed == 0.0)
+	{
+		return;
+	}
+
+	thrustspeed += speed;
+
+	constexpr auto max_speed = 2.0 * MINDIST;
+
+	if (speed > max_speed)
+	{
+		move_x *= max_speed / speed;
+		move_y *= max_speed / speed;
+	}
+
+	const auto old_x = player->x;
+	const auto old_y = player->y;
+
+	ThrustVector(move_x, move_y);
+
+	// Don't keep pushing into a wall we were stopped by.
+	if (move_x != 0.0 && player->x == old_x)
+	{
+		momentum_velocity_x_ = 0.0;
+	}
+
+	if (move_y != 0.0 && player->y == old_y)
+	{
+		momentum_velocity_y_ = 0.0;
+	}
+}
+
+} // namespace
