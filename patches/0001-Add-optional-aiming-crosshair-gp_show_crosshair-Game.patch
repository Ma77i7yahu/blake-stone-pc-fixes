+
 	bool fizzle_fx_is_enabled_{};
 	bool fizzle_fx_is_fading_{};
 	int fizzle_fx_color_index_{};
@@ -1059,6 +1068,12 @@ private:
 	void update_3d_fade_vb();
 	void update_3d_fade_ortho();
 
+	void destroy_crosshair() noexcept;
