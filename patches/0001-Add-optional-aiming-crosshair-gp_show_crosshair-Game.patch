+
 	void destroy_3d_fade_r2_texture() noexcept;
 	void create_r3_fade_r2_texture();
 
@@ -4868,6 +4883,161 @@ try {
 	}
 
 	update_vertex_buffer<FadeVertex>(r3_fade_vb_, 0, 4, vertices.data());
+
